cmake_minimum_required(VERSION 3.24)
if(NOT IS_DIRECTORY "${APP}" OR NOT APP_BINARY OR NOT HELPER_BINARY)
    message(FATAL_ERROR "Provide an app directory and its two executable names")
endif()
file(REAL_PATH "${APP}" app_root)
file(GLOB_RECURSE entries LIST_DIRECTORIES true "${APP}/*")
foreach(entry IN LISTS entries)
    if(IS_SYMLINK "${entry}")
        file(REAL_PATH "${entry}" resolved)
        cmake_path(IS_PREFIX app_root "${resolved}" NORMALIZE contained)
        if(NOT contained)
            message(FATAL_ERROR "App contains an external symbolic link: ${entry}")
        endif()
    endif()
    if(IS_DIRECTORY "${entry}")
        continue()
    endif()
    if(entry MATCHES "\\.(exe|dll|pdb|log|pyc)$" OR entry MATCHES "-tests" OR entry MATCHES "/QtTest$")
        message(FATAL_ERROR "Unexpected file in app: ${entry}")
    endif()
    execute_process(COMMAND file -b "${entry}" OUTPUT_VARIABLE file_type RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${entry}")
    endif()
    if(file_type MATCHES "^Mach-O")
        execute_process(COMMAND otool -L "${entry}" OUTPUT_VARIABLE dependencies RESULT_VARIABLE result)
        # otool prints the inspected file's absolute path on its first line.
        # Only dependency lines must be independent of the build machine.
        string(REGEX REPLACE "^[^\n]*\n" "" dependency_lines "${dependencies}")
        if(NOT result EQUAL 0 OR dependency_lines MATCHES "/opt/homebrew/|/Users/")
            message(FATAL_ERROR "Unresolved build-machine dependency in ${entry}: ${dependencies}")
        endif()
    endif()
endforeach()
foreach(binary IN ITEMS "${APP_BINARY}" "${HELPER_BINARY}")
    set(executable "${APP}/Contents/MacOS/${binary}")
    execute_process(COMMAND lipo -archs "${executable}" OUTPUT_VARIABLE architectures RESULT_VARIABLE result)
    if(NOT EXISTS "${executable}" OR NOT result EQUAL 0 OR NOT architectures MATCHES "(^|[ \t])arm64([ \t\r\n]|$)")
        message(FATAL_ERROR "Missing arm64 executable: ${executable}")
    endif()
endforeach()
